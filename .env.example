# Canonical site URL, used for metadata, sitemap and OpenGraph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. GA4 measurement ID. The previous site (index6.html) used G-RXJKP5MVQW.
# Leave empty to disable GA4; analytics events then only log in development.
NEXT_PUBLIC_GA_ID=

# Review mode shows [verify] and [Content pending] markers.
# Defaults: ON in `next dev`, OFF in production builds. Set "true" to preview markers on a deployed preview.
NEXT_PUBLIC_REVIEW_MODE=
